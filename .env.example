# ---------- Authentik / Postgres ----------
POSTGRES_DB=db-name
POSTGRES_USER=user-name
POSTGRES_PASSWORD=change-me-postgres-password
AUTHENTIK_SECRET_KEY=change-me-authentik-secret-long-random
AUTHENTIK_URL=http://localhost:9000
AUTHENTIK_ISSUER_PATH=http://authentik-server:9000/application/o/
AUTHENTIK_INTERNAL_URL=http://authentik-server:9000
BACKEND_INTERNAL_URL=http://backend:5032

# ---------- Backend / Authentik OIDC ----------
CLIENT_ID=change-me-client-id
CLIENT_SECRET=change-me-client-secret
BACKEND_URL=http://localhost:8080

# ---------- Backend / SQL Server ----------
ASPNETCORE_ENVIRONMENT=Development
MSSQL_SA_PASSWORD=change-me-sqlserver-sa-password-strong!

# ---------- RabbitMQ ----------
RABBITMQ_HOST=raid-rabbit
RABBITMQ_URL=http://localhost:15672
RABBITMQ_VHOST=imperial
RABBITMQ_USERNAME=imperial-website
RABBITMQ_QUEUE_RAIDS_COMPLETED=raids.completed.q

# ---------- Frontend ----------
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080/api/
